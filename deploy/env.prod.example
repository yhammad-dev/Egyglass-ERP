# ═══════════════════════════════════════════════════════════════════════════════
#  EgyGlass ERP — متغيّرات بيئة الإنتاج
#  الوجهة على الخادم:  /etc/egyglass/env      (chmod 600 · مالكها root)
#  🔴 خارج المستودع تمامًا. لا تضعه داخل مجلد المشروع ولو للحظة.
# ═══════════════════════════════════════════════════════════════════════════════
#
# كل قيمة أدناه <PLACEHOLDER> تُولَّد **وقت النشر**. ممنوع منعًا باتًّا استعمال أي
# قيمة كانت يومًا في المستودع أو في البيئة المحلية أو في البيئة القديمة (L-09).

# ── وسم الصورة — الـSHA لا `latest` ────────────────────────────────────────────
# `latest` هو بالضبط ما يجعل «الحاوية تخدم بناءً قديمًا» غير قابل للكشف.
APP_IMAGE=egyglass-app:<GIT_SHA>

# ── قاعدة البيانات ────────────────────────────────────────────────────────────
# ولّدها:  openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
POSTGRES_PASSWORD=<GENERATE_AT_DEPLOY>
# ⚠️ نفس كلمة المرور أعلاه، مكتوبة صراحةً — لا يوجد استبدال متغيّرات داخل هذا
#    الملف عند قراءته بـ--env-file (بخلاف الـshell). الرمز @ في كلمة المرور يجب
#    أن يُرمَّز %40 داخل الرابط، ولهذا يستبعد أمر التوليد أعلاه الرموز الخاصة.
DATABASE_URL=postgresql://egyglass:<SAME_PASSWORD>@db:5432/egyglass?schema=public

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
# ولّده:  openssl rand -base64 32
AUTH_SECRET=<GENERATE_AT_DEPLOY>

# 🔴 يجب أن يبدأ بـhttps ويطابق ما يكتبه المستخدم في المتصفح **حرفيًّا**.
#    اختلافه عن العنوان الفعلي يُنتج حلقة إعادة توجيه إلى /login بعد دخول صحيح.
APP_PUBLIC_URL=https://<ELASTIC_IP_OR_DOMAIN>
